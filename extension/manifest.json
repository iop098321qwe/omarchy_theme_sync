{
  "manifest_version": 3,
  "name": "Grymm's Omarchy Theme Companion",
  "version": "0.0.1",
  "description": "Match Grymm's start page to the local Omarchy palette.",
  "minimum_chrome_version": "105",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://iop098321qwe.github.io/main_page/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": ""
}
